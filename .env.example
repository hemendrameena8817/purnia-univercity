# -------------------------------------------------
# PUP UMIS Backend Environment Variables
# -------------------------------------------------
# Copy this file to .env and update the values

# -------------------------------------------------
# Environment Selection
# -------------------------------------------------
# Options: 'development' or 'production'
DJANGO_ENV=development

# -------------------------------------------------
# Django Settings
# -------------------------------------------------
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# -------------------------------------------------
# Database Configuration (for production MySQL)
# -------------------------------------------------
DB_NAME=pup_umis
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306

# -------------------------------------------------
# Timezone
# -------------------------------------------------
TIME_ZONE=Asia/Kolkata

# -------------------------------------------------
# JWT Settings
# -------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=1

# -------------------------------------------------
# CORS Settings (comma-separated)
# -------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend-domain.com

# -------------------------------------------------
# CSRF Settings (comma-separated)
# -------------------------------------------------
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://*.ngrok-free.app

# -------------------------------------------------
# Email Settings (Production)
# -------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@puphd.org

# -------------------------------------------------
# Security (Production)
# -------------------------------------------------
SECURE_SSL_REDIRECT=True

# -------------------------------------------------
# Logging
# -------------------------------------------------
DJANGO_LOG_LEVEL=INFO
